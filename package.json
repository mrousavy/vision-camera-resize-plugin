{
  "name": "vision-camera-resize-plugin",
  "version": "4.0.0",
  "description": "A Nitro module for fast VisionCamera Frame resizing, cropping and pixel-format conversion",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "libyuv",
    "nitrogen",
    "nitro.json",
    "react-native.config.js",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "rm -rf tsconfig.tsbuildinfo && rm -rf lib && yarn specs && bob build",
    "specs": "tsc --noEmit false && nitrogen --logLevel=\"debug\"",
    "typecheck": "tsc --noEmit",
    "typescript": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "rm -rf android/build example/android/build example/android/app/build example/ios/build lib nitrogen/generated",
    "prepare": "git submodule update --init --recursive && yarn build",
    "update-submodule": "git submodule update --remote --merge",
    "release": "release-it",
    "check-all": "scripts/check-all.sh"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrousavy/vision-camera-resize-plugin.git"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mrousavy/vision-camera-resize-plugin/issues"
  },
  "homepage": "https://github.com/mrousavy/vision-camera-resize-plugin#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@release-it/conventional-changelog": "^8.0.1",
    "@types/react": "19.2.14",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nitrogen": "0.35.0",
    "prettier": "^3.2.4",
    "react": "19.2.3",
    "react-native": "0.84.0",
    "react-native-builder-bob": "^0.37.0",
    "react-native-nitro-image": "0.13.0",
    "react-native-nitro-modules": "0.35.0",
    "react-native-vision-camera": "5.0.0-beta.6",
    "react-native-worklets": "0.7.4",
    "release-it": "^17.0.3",
    "turbo": "^1.10.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-vision-camera": "^5.0.0-beta.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "nitrogen/generated/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}
